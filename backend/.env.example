# Server
PORT=8080

# SMTP — fill in your email provider settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# Where contact form emails are delivered
TO_EMAIL=hello@nexuslab.io

# CORS — comma-separated origins, or * for any
# In production set this to your domain, e.g.: https://nexuslab.io
CORS_ORIGINS=*
